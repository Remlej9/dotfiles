// -*- mode: jsonc -*-
{
    "layer": "top",
    "position": "top",
    "height": 38, // pills = height minus their 4px top/bottom margin
    "spacing": 0,
    "margin-top": 2,
    "margin-left": 0,
    "margin-right": 0,
    // Choose the order of the modules
    "modules-left": [
        "custom/launcher",
        "tray",
        "sway/mode",
        "custom/lastfm-anim",
        "custom/lastfm-text",
        "sway/window",
    ],
    "modules-center": [
        "sway/workspaces",
    ],
    "modules-right": [
        "custom/updates",
        "pulseaudio",
        "network",
        "custom/tailscale",
        "temperature",
        "cpu",
        "memory",
        "disk",
        "battery",
        "power-profiles-daemon",
        "clock",
        "custom/notification",
        "custom/power"
    ],
    "sway/mode": {
        "format": "<span style=\"italic\">{}</span>"
    },
    "disk": {
        "interval": 30,
        "format": "{free} 󰋊",
        "path": "/"
    },
    "tray": {
        "spacing": 10
    },
    "clock": {
        "interval": 1,
        "format": "{:%H:%M:%S}",
        "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>",
        "format-alt": "{:%Y-%m-%d}",
        "calendar": {
            "iso8601": true,
            "weeks-pos": "right"
        }
    },
    "cpu": {
        "format": "{usage}% ",
        "tooltip": false
    },
    "memory": {
        "format": "{}% "
    },
    "temperature": {
        // CPU package sensor (coretemp "Package id 0"). Located by device path
        // because hwmonN / thermal_zoneN numbers can change between boots.
        "hwmon-path-abs": "/sys/devices/platform/coretemp.0/hwmon",
        "input-filename": "temp1_input",
        "critical-threshold": 80,
        "format": "{temperatureC}°C {icon}",
        "format-icons": ["", "", ""]
    },
    "battery": {
        "states": {
            "warning": 30,
            "critical": 15
        },
        "format": "{capacity}% {icon}",
        "format-charging": "{capacity}% {icon} 󱐋",
        "format-plugged": "{capacity}% ",
        "format-full": "{capacity}% 󰂄",
        "format-icons": {
            "charging": [
                "󰢟", "󰢜", "󰂆", "󰂇", "󰂈", "󰢝", "󰂉", "󰢞", "󰂊", "󰂋", "󰂅"
            ],
            "default": [
                "󰂎", "󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"
            ]
        }
    },
    "power-profiles-daemon": {
      "format": "{icon}",
      "tooltip-format": "Power profile: {profile}\nDriver: {driver}",
      "tooltip": true,
      "format-icons": {
        "default": "",
        "performance": "",
        "balanced": "",
        "power-saver": ""
      }
    },
    "network": {
        "format-wifi": "{essid} ({signalStrength}%) ",
        "format-ethernet": "{ipaddr}/{cidr} ",
        "tooltip-format": "{ifname} {ipaddr}/{cidr} via {gwaddr}",
        "format-linked": "{ifname} (No IP) ",
        "format-disconnected": "Disconnected ⚠",
        "on-click": "iwgtk"
    },
    "pulseaudio": {
        "format": "{volume}% {icon} {format_source}",
        "format-bluetooth": "{volume}% {icon} {format_source}",
        "format-bluetooth-muted": " {icon} {format_source}",
        "format-muted": " {format_source}",
        "format-source": "{volume}% ",
        "format-source-muted": "",
        "format-icons": {
            "headphone": "",
            "hands-free": "",
            "headset": "",
            "phone": "",
            "portable": "",
            "car": "",
            "default": ["", "", ""]
        },
        "on-click": "pavucontrol"
    },
    "custom/lastfm-anim": {
        "exec": "python3 $HOME/.config/waybar/scripts/lastfm.py --anim",
        "return-type": "json",
        "format": "{}",
        "tooltip": false
    },

    "custom/lastfm-text": {
        "exec": "python3 $HOME/.config/waybar/scripts/lastfm.py --text",
        "on-click": "python3 $HOME/.config/waybar/scripts/lastfm.py --open",
        "return-type": "json",
        "format": "{}",
        "escape": true,
        "tooltip": true
    },
    "custom/notification": {
        "tooltip": false,
        "format": "{icon}",
        "format-icons": {
          "notification": "<span foreground='#ed4231'><sup></sup></span>",
          "none": "",
          "dnd-notification": "<span foreground='#ed4231'><sup></sup></span>",
          "dnd-none": "",
          "inhibited-notification": "<span foreground='#ed4231'><sup></sup></span>",
          "inhibited-none": "",
          "dnd-inhibited-notification": "<span foreground='#ed4231'><sup></sup></span>",
          "dnd-inhibited-none": ""
        },
        "return-type": "json",
        "exec-if": "which swaync-client",
        "exec": "swaync-client -swb",
        "restart-interval": 2, // retry if swaync isn\'t up yet at login
        "on-click": "swaync-client -t -sw",
        "on-click-right": "swaync-client -d -sw",
        "escape": true
    },
    "custom/power": {
        "format" : "⏻ ",
		"tooltip": false,
		"menu": "on-click",
		"menu-file": "$HOME/.config/waybar/power_menu.xml",
		"menu-actions": {
			"shutdown": "systemctl poweroff",
			"reboot": "systemctl reboot",
			"suspend": "systemctl suspend"
		}
    },
    "custom/launcher": {
        "format": "  ",
        "on-click": "wofi --show drun",
        "tooltip": false
    },
    "custom/tailscale": {
        "exec": "~/.config/waybar/scripts/tailscale.sh --status",
        "on-click": "~/.config/waybar/scripts/tailscale.sh --toggle",
        "on-click-right": "~/.config/waybar/scripts/tailscale.sh --toggle-exit-node",
        "exec-on-event": true,
        "format": "{icon} {text}",
        "format-icons": {
          "connected": "",
          "exit-node": "",
          "stopped": "",
          "connecting": "",
          "disconnecting": ""
        },
        "tooltip": true,
        "return-type": "json",
        "interval": 5
    },
    "custom/updates": {
        "hide-empty-text": true,
        // Hidden while there are no updates (script prints empty text).
        // SIGRTMIN+8 forces a re-check on every bar; the click action sends it
        // once yay finishes: pkill -RTMIN+8 -x waybar
        "format": "{} 󰚰",
        "exec": "~/.config/waybar/scripts/updates.sh",
        "return-type": "json",
        "interval": 3600,
        "signal": 8,
        "on-click": "kitty --hold -e sh -c 'yay -Syu; pkill -RTMIN+8 -x waybar'",
        "tooltip": true
    },
}
